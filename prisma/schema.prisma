// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

 
enum Role {
    PRODUCTION_MANAGER
    WAREHOUSE_MANAGER
    SALES_REP
  }
  
enum ProductType {
    TABLE
    CHAIR
    DOOR
  }
  
enum WarehouseLocation {
    ILUPEJU
    SANGO_TEDO
    MOWE
}
  
enum WarehouseName {
    SwiftStock
    PrimeStorage
    NextGen
}

enum OrderStatus {
    PENDING
    SUCCESSFUL
    FAILED
  }
  
enum DistributionStatus {
    PENDING
    SUCCESSFUL
    FAILED
  }
  
model User {
    id        Int      @id @default(autoincrement())
    email     String   @unique
    password  String
    role      Role
    warehouseId String?
    warehouse Warehouse? @relation(fields: [warehouseId], references: [id])
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
  }
  
  model Production {
    id            String                 @id @default(uuid())
    product       ProductType
    amount        Int
    date          DateTime
    distributions WarehouseDistribution[] @relation("ProductionDistribution")
    createdAt     DateTime               @default(now())
    updatedAt     DateTime               @updatedAt
}

  model Warehouse {
    id               String      @id @default(uuid())
    name      WarehouseName @unique
    location  WarehouseLocation @unique
    capacity  Int
    distributions WarehouseDistribution[]
    orders    Order[]
    users     User[]   
    createdAt DateTime    @default(now())
    updatedAt DateTime    @updatedAt
  }

model WarehouseDistribution {
    id            String               @id @default(uuid())
    production    Production?          @relation("ProductionDistribution", fields: [productionId], references: [id])
    productionId  String?
    warehouse     Warehouse            @relation(fields: [warehouseId], references: [id])
    warehouseId   String
    product       ProductType
    amount        Int
    status        DistributionStatus
    distributedAt DateTime
    createdAt     DateTime             @default(now())
    updatedAt     DateTime             @updatedAt
  }

  model Order {
    id               String      @id @default(uuid())
    customerName     String
    customerAddress  String
    product          ProductType
    amount           Int
    warehouse        Warehouse   @relation(fields: [warehouseId], references: [id])
    warehouseId      String
    status           OrderStatus
    createdAt        DateTime    @default(now())
    updatedAt        DateTime    @updatedAt
  }
